 260           void CalulateCRC(unsigned char *pIndata,unsigned char len,unsigned char *pOutData)
 261           {
 262   1           unsigned char i,n;
 263   1           ClearBitMask(DivIrqReg,0x04);
 264   1           WriteRawRC(CommandReg,PCD_IDLE);
