 268   1           WriteRawRC(CommandReg, PCD_CALCCRC);
 269   1           i = 0xFF;
 270   1           do 
 271   1           {
 272   2               n = ReadRawRC(DivIrqReg);
 273   2               i--;
 274   2           }
 275   1           while ((i!=0) && !(n&0x04));
 276   1           pOutData[0] = ReadRawRC(CRCResultRegL);
 277   1           pOutData[1] = ReadRawRC(CRCResultRegM);
 278   1       }
