  29          /**********************************************************
  30          
  31          检查LCD忙状态
  32          
  33          lcd_busy为1时，忙，等待。
  34          lcd-busy为0时,闲，可写指令与数据。
  35          
  36           **********************************************************/
  37          void lcd_busy()
  38          {
  39   1          int8u busy;
  40   1          LCD_RS = 0;
  41   1          LCD_RW = 1;
  42   1          LCD_EN = 0;
  43   1          while(1){
  44   2                      Delay1us();
  45   2              DATA_PORT=0xff;
  46   2              LCD_EN=1;
  47   2                      Delay1us();
  48   2              busy = DATA_PORT;
  49   2              LCD_EN = 0;
  50   2              if((busy&0x80)==0){
  51   3                  break;
  52   3              }
  53   2          }
  54   1      }
