  82          //写TM1637，从低位开始传送
  83          void TM1637_Write(uint8_t dat)
  84          {
  85   1          uint8_t i;
  86   1      
  87   1          for(i = 0; i < 8; i++){
  88   2                  CLK(0);
  89   2                      Delay2us();  //时钟拉低
  90   2                      
  91   2                      /* 输出 */
  92   2                  if(dat & 0x01)  //该位为1
  93   2                          DIO(1);
  94   2                      else  //该位为0
  95   2                          DIO(0);     
  96   2              
  97   2                      Delay2us();
  98   2                      dat  >>= 1;  //先发低位
  99   2                      CLK(1);
 100   2                      Delay2us();  //时钟拉高
 101   2              }
 102   1       
 103   1              /* 获取ACK应答 */
 104   1              if(TM1637_Wait_Ack() != HAL_OK){
 105   2              
 106   2                  //printf("TM1637发送错误!\r\n"); 
 107   2          }        
 108   1      }
