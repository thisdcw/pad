line level    source

   1          
   2          #include"pwm.h"
   3          
   4          void pwm_init(void)
   5          {
   6   1              P_SW2 |= 0x80;
   7   1              PWMB_PS &= ~0x30;   //PWM7
   8   1              PWMB_PS |= 0x20;    //PWM7 use P02
   9   1              PWMB_CR1 = 0x01;
  10   1              PWMB_CCER2 = 0x00;  //写CCMRx前必须先清0CCERx
  11   1              PWMB_CCMR3 = 0x68;  //设置CC1PWMB输出模式,输出比较预装功能
  12   1              PWMB_CCER2 = 0x01;  //使能CC2
  13   1              PWMB_PSCR = 0;        
  14   1              PWMB_CCR7 = 0;      //占空比
  15   1              PWMB_ARR = 110;     //周期
  16   1              PWMB_ENO |= 0x10;   //enable PWM7
  17   1              PWMB_BKR |= 0x80;   //主输出使能
  18   1      }
  19          
  20          void Set_PWM(unsigned char power)
  21          {
  22   1              P_SW2 |= 0x80;
  23   1              PWMB_CCR7 = power;
  24   1      }


