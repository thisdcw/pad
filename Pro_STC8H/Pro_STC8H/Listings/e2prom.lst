  20                 
  21          #include "e2prom.h"
  22          
  23          /*--------------------------------------
  24          Disable ISP/IAP/EEPROM fuction
  25          Make MCU in a safe state
  26          ---------------------------------------*/
  27          void IapIdle(void)
  28          {
  29   1              IAP_CONTR = 0;      //Close IAP function
  30   1              IAP_CMD = 0;        //Clear command to standby
  31   1              IAP_TRIG = 0;       //Clear trigger register
  32   1              IAP_ADDRH = 0x80;   //Data ptr point to non-EEPROM area
  33   1              IAP_ADDRL = 0x00;   //Clear IAP address to prevent misuse
  34   1      }
  35          
  36          /*--------------------------------------
  37          Read one byte from ISP/IAP/EEPROM area
  38          Input: addr(ISP/IAP/EEPROM address)
  39          Output: Flash data
  40          ---------------------------------------*/
  41          int8u IapReadByte(int16u addr)
  42          {
  43   1              int8u dat;                     //data buffer
  44   1              F0=EA;
  45   1              EA=0;
  46   1              IAP_CONTR = ENABLE_IAP;        //Open IAP function and set wait time
  47   1          IAP_TPS   =12;
  48   1              IAP_CMD = CMD_READ;            //Set ISP/IAP/EEPROM READ command
  49   1              IAP_ADDRL = (int8u)addr;       //Set ISP/IAP/EEPROM low address
  50   1              IAP_ADDRH = (int8u)(addr>>8);  //Set ISP/IAP/EEPROM high address
  51   1              IAP_TRIG = 0x5a;               //Send trigger command1(0x5a)
  52   1              IAP_TRIG = 0xa5;               //Send trigger command2(0xa5)
  53   1              _nop_();                       //MCU will hold here until ISP/IAP/EEPROM operation complete
  54   1              dat = IAP_DATA;                //Read ISP/IAP/EEPROM data
C51 COMPILER V9.57.0.0   E2PROM                                                            03/18/2024 15:31:20 PAGE 2   

  55   1              IapIdle();                     //Close ISP/IAP/EEPROM function
  56   1              EA=F0;
  57   1              return dat;                    //Return Flash data
  58   1      }
  59          
  60          /*--------------------------------------
  61          Write one byte to ISP/IAP/EEPROM area
  62          Input: addr(ISP/IAP/EEPROM address) 
  63                 dat(ISP/IAP/EEPROM data)
  64          Output: non
  65          ---------------------------------------*/
  66          void IapWriteByte(int16u addr,int8u dat)
  67          {
  68   1              F0=EA;
  69   1              EA=0;
  70   1              IAP_CONTR = ENABLE_IAP;        //Open IAP function and set wait time
  71   1          IAP_TPS   =12;
  72   1              IAP_CMD = CMD_WRITE;           //Set ISP/IAP/EEPROM write command
  73   1              IAP_ADDRL = (int8u)addr;       //Set ISP/IAP/EEPROM low address
  74   1              IAP_ADDRH = (int8u)(addr>>8);  //Set ISP/IAP/EEPROM high address
  75   1              IAP_DATA = dat;                //Write ISP/IAP/EEPROM data
  76   1              IAP_TRIG = 0x5a;               //Send trigger command1(0x5a)
  77   1              IAP_TRIG = 0xa5;               //Send trigger command2(0xa5)
  78   1              _nop_();                       //MCU will hold here until ISP/IAP/EEPROM operation complete
  79   1              IapIdle();                     //Close ISP/IAP/EEPROM function
  80   1              EA=F0;
  81   1      }
  82          
  83          /*--------------------------------------
  84          Erase one sector area
  85          Input: addr(ISP/IAP/EEPROM address)
  86          Output: non
  87          --------------------------------------*/
  88          void IapEraseSector(int16u addr)
  89          {
  90   1              F0=EA;
  91   1              EA=0;
  92   1              IAP_CONTR = ENABLE_IAP;        //Open IAP function and set wait time
  93   1          IAP_TPS   =12;
  94   1              IAP_CMD = CMD_ERASE;           //Set ISP/IAP/EEPROM erase command
  95   1              IAP_ADDRL = (int8u)addr;       //Set ISP/IAP/EEPROM low address
  96   1              IAP_ADDRH = (int8u)(addr>>8);  //Set ISP/IAP/EEPROM high address
  97   1              IAP_TRIG = 0x5a;               //Send trigger command1(0x5a)
  98   1              IAP_TRIG = 0xa5;               //Send trigger command2(0xa5)
  99   1              _nop_();                       //MCU will hold here until ISP/IAP/EEPROM operation complete
 100   1              IapIdle();                     //Close ISP/IAP/EEPROM function
 101   1              EA=F0;
 102   1      }
