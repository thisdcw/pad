 104          /***************************存取字数*************************/
 105          //四个字节
 106           /********************************************************************
 107          函数：STC 向指定地址写一字数据
 108          ********************************************************************/
 109          void EROM_write_word(int16u addr,  int32u dat)
 110          {     
 111   1          IapWriteByte(addr++, ((int8u *)&dat)[0]); 
 112   1          IapWriteByte(addr++, ((int8u *)&dat)[1]); 
 113   1          IapWriteByte(addr++, ((int8u *)&dat)[2]); 
 114   1          IapWriteByte(addr,   ((int8u *)&dat)[3]);   
 115   1      }
 116          
C51 COMPILER V9.57.0.0   E2PROM                                                            03/18/2024 15:31:20 PAGE 3   

 117          /********************************************************************
 118          函数：STC 读指定地址一字数据        
 119          ********************************************************************/
 120          int32u EROM_read_word(int16u addr)
 121          {                      
 122   1          int32u dat;
 123   1       
 124   1          ((int8u *)&dat)[0] = IapReadByte(addr++);
 125   1          ((int8u *)&dat)[1] = IapReadByte(addr++);
 126   1          ((int8u *)&dat)[2] = IapReadByte(addr++);
 127   1          ((int8u *)&dat)[3] = IapReadByte(addr);
 128   1       
 129   1          return dat;                        
 130   1      }


